# ----------------------------------------------------------------------------
# Git Ignore Configuration - CineMax (SWP391-Gr3)
# ----------------------------------------------------------------------------

# Compiled Java class files & build directories
target/
*.class
*.war
*.ear
*.jar

# Temporary runtime & test directories
.tmp_class/
tmp/
*.log

# IDE & Editor metadata
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Local properties & credentials
*.local.properties
db.local.properties

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Office temporary & lock files
.~lock.*
~$*
*.tmp

# Documentation, spreadsheets & auxiliary files
*.xls
cine-diagram/
Feature_Tree*.md

# Allow docs/testing/ for test deliverables while ignoring other docs
!docs/
docs/*
!docs/testing/
!docs/testing/**
