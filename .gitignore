# Compiled Java class files & build directories
target/
*.class
*.war
*.ear
*.jar

# Temporary runtime & test directories
.tmp_class/
tmp/
*.log
scratch/

# IDE & Editor metadata
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Local properties & credentials
*.local.properties
db.local.properties

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Office temporary & lock files
.~lock.*
~$*
*.tmp

# Documentation, spreadsheets, plans & local deliverables
docs/
plans/
*.xls
*.xlsx
cine-diagram/
Feature_Tree*.md
