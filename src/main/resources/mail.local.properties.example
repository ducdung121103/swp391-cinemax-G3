# Copy file này thành mail.local.properties rồi điền App Password thật.
# mail.local.properties đã được gitignore — không commit lên Git.
#
# Tạo App Password: https://myaccount.google.com/apppasswords
# (bật 2-Step Verification trước)

mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.starttls.required=true

mail.username=your-gmail@gmail.com
mail.password=xxxx xxxx xxxx xxxx

mail.from.name=CineMax Cinema
mail.from.address=your-gmail@gmail.com
mail.otp.expiry.minutes=10
